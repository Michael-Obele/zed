#!/usr/bin/env bash
# update-patches: Export your MCP feature commits as portable .patch files.
#
# Run this after making changes to your feature commits. The patches serve
# as a portable backup — if a rebase ever goes wrong, you can reapply:
#   git checkout -b recovery upstream/main
#   git am patches/*.patch
#
# Usage:
#   ./script/update-patches
#
# Output: patches/ directory with one .patch per feature commit.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

UPSTREAM="upstream"
PATCH_DIR="patches"
# The build branch is synced to the latest upstream *stable tag* (see
# .github/workflows/mcp-nightly.yml), so this fork's own commits are what comes after
# that tag — not everything since upstream/main, which would export 100+ upstream commits.
SYNC_BASE="$(git describe --tags --abbrev=0 "${UPSTREAM}/main" 2>/dev/null || echo "${UPSTREAM}/main")"

mkdir -p "$PATCH_DIR"
rm -f "$PATCH_DIR"/*.patch

echo "→ Exporting commits in ${SYNC_BASE}..HEAD to $PATCH_DIR/ ..."
git format-patch -o "$PATCH_DIR" "${SYNC_BASE}..HEAD"

echo ""
echo "✓ Done."
echo "  To reapply on a fresh upstream:"
echo "    git checkout -b recovery upstream/main"
echo "    git am patches/*.patch"
